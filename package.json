{
  "name": "plc-simulator",
  "version": "1.0.0",
  "description": "PLC Device Communication Simulator for HMI Design",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "dev:frontend": "cd web && npm run dev",
    "build:frontend": "cd web && npm run build",
    "build": "npm run build:frontend && tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "db:migrate": "ts-node scripts/migrate-database.ts migrate",
    "db:rollback": "ts-node scripts/migrate-database.ts rollback",
    "seed": "ts-node scripts/seed.ts",
    "seed:reset": "ts-node scripts/seed.ts --reset"
  },
  "keywords": [
    "plc",
    "simulator",
    "hmi",
    "modbus",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/nedb": "^1.8.16",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.3.4",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "moment": "^2.30.1",
    "nedb": "^1.8.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
