[Unit]
Description=PLC Simulator (Node.js)
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/plc-simulator
ExecStart=/usr/bin/node /opt/plc-simulator/dist/main.js
EnvironmentFile=/opt/plc-simulator/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target